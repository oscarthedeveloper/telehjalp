# =================================================================
# TeleHjälp – miljövariabler
#
# Lokalt: kopiera denna fil till .env.local och fyll i.
# I drift: lägg in samma variabler i Netlify under
#          Site configuration → Environment variables.
# =================================================================

# -----------------------------------------------------------------
# Databas (Turso)
# -----------------------------------------------------------------
# Adressen till databasen. Turso anger den som libsql://…
# TeleHjälp översätter själv till https, så du kan klistra in den som den är.
#   turso db show telehjalp --url
TURSO_DATABASE_URL=libsql://telehjalp-dittnamn.turso.io

# Token som ger läs- och skrivrättighet till databasen.
#   turso db tokens create telehjalp
TURSO_AUTH_TOKEN=eyJhbGciOi...

# -----------------------------------------------------------------
# Admin
# -----------------------------------------------------------------
# Hemlig del av adminlänken. Adressen blir:
#   https://din-sida.netlify.app/admin?k=DEN-HAR-STRANGEN
# Utan rätt nyckel svarar sidan "Sidan finns inte".
ADMIN_KEY=byt-ut-mig-mot-en-lang-slumpstrang

# PIN-koden du knappar in efter att ha öppnat adminlänken.
ADMIN_PIN=134679

# Slumpsträng som signerar inloggningskakan. Minst 16 tecken.
ADMIN_SECRET=byt-ut-mig-mot-en-annan-lang-slumpstrang
