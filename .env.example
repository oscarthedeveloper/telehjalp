# =================================================================
# TeleHjälp – miljövariabler
#
# Lokalt: kopiera denna fil till .env.local och fyll i.
# I drift: lägg in samma variabler i Netlify under
#          Site configuration → Environment variables.
# =================================================================

# -----------------------------------------------------------------
# Databas (Turso)
# -----------------------------------------------------------------
# Adressen till databasen. Turso anger den som libsql://…
# TeleHjälp översätter själv till https, så du kan klistra in den som den är.
#   turso db show telehjalp --url
TURSO_DATABASE_URL=libsql://telehjalp-oscarboom123.aws-eu-west-1.turso.io

# Token som ger läs- och skrivrättighet till databasen.
#   turso db tokens create telehjalp
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODY3OTk0MjksImlkIjoiMDFhMDA1OGEtZTcwMS03Yzg2LWFhNmMtZjVjZTEyOWQ4YWIwIiwia2lkIjoibWYtbkhCMDUtVjAyRnkxd2xUR2FxX1d4V216SkZJYmt2VlktSTdmamQ3byIsInJpZCI6ImQxYTA4NzA2LWU5ZmYtNDhiMy1hNzE3LTlmN2Q3NjQyMjNhMSJ9.o8-70xKzzJ1iaSzEvfupjld_34He7XzQ-xw-0QIDpS2jaX8y7rstdvlVkCCJ1A2C7aW_OOQ0vyAGyjE3LvUFDg

